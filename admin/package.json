{
  "name": "las-flores-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "cd .. && npm run build --workspace=shared",
    "build": "next build",
    "start": "next start",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:css": "cd .. && node scripts/check-css-color-literals.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "js-yaml": "~5.3.0",
    "next": "~16.3.2",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-markdown": "~10.1.0",
    "remark-gfm": "~4.0.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "~16.3.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.5",
    "@types/node": "~20.19.43",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@typescript-eslint/parser": "~8.67.0",
    "@vitejs/plugin-react": "~6.0.3",
    "eslint": "~10.8.1",
    "jsdom": "~30.0.1",
    "typescript": "5.9.3",
    "vitest": "~4.1.11"
  }
