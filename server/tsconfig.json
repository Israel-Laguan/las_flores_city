{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "paths": {
      "@las-flores/shared": ["../shared/src/index.ts"],
      "@las-flores/infra": ["../infra/src/index.ts"],
      "@las-flores/api-contracts": ["../api/contracts/src/index.ts"],
      "@las-flores/api-planning": ["../api/planning/src/index.ts"]
    }
  },
  "include": ["src/**/*", "../shared/src/**/*", "../infra/src/**/*", "../api/contracts/src/**/*", "../api/planning/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
