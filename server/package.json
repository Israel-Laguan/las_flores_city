{
  "name": "las-flores-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:intake": "tsx watch src/intake.ts",
    "build": "tsc && node scripts/copyMigrations.js",
    "start": "node dist/server/src/index.js",
    "start:intake": "node dist/server/src/intake.js",
    "schema:migrate": "tsx src/database/migrate.ts",
    "migrate": "tsx src/content/cli.ts ../content",
    "validate": "tsx src/content/validate-cli.ts ../content",
    "validate:schema": "tsx src/content/validate-cli.ts ../content --schema-only",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "npx --no-install jest tests/unit tests/smoke --forceExit && npx --no-install jest tests/integration --detectOpenHandles --forceExit",
    "test:unit": "npx --no-install jest tests/unit --detectOpenHandles --forceExit",
    "test:smoke": "npx --no-install jest tests/smoke --detectOpenHandles --forceExit",
    "test:integration": "npx --no-install jest tests/integration --runInBand --detectOpenHandles --forceExit",
    "test:load": "k6 run tests/load/breakthrough_rush.js",
    "seed:load-users": "tsx scripts/seed_load_test_users.ts",
    "seed:dev": "tsx src/database/seedAdmin.ts",
    "seed:players": "tsx src/database/seedPlayers.ts",
    "seed:graph": "tsx scripts/seed-graph.ts",
    "resync:graph": "tsx scripts/resync-graph.ts",
    "seed:all": "npm run seed:dev && npm run seed:players",
    "plan:intake": "tsx scripts/run_plan_intake.ts",
    "plan:amend": "tsx scripts/run_plan_amend.ts",
    "plan:diff": "tsx scripts/run_plan_diff.ts",
    "backfill:critique-graph": "tsx scripts/backfill-critique-graph.ts",
    "probe:content-urls": "tsx scripts/probe_content_url_coverage.ts",
    "flow:plan-template": "tsx scripts/run_plan_template_flow.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.1110.0",
    "@aws-sdk/cloudfront-signer": "~3.1108.0",
    "@aws-sdk/s3-request-presigner": "~3.1110.0",
    "@las-flores/infra": "*",
    "bcryptjs": "~3.0.3",
    "cors": "~2.8.6",
    "dotenv": "~17.4.2",
    "express": "~5.2.1",
    "glob": "~13.0.6",
    "ioredis": "~5.11.1",
    "js-yaml": "~5.3.0",
    "jsonwebtoken": "~9.0.3",
    "neo4j-driver": "~5.28.0",
    "pg": "~8.23.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "~3.0.0",
    "@types/cors": "~2.8.19",
    "@types/express": "~5.0.6",
    "@types/jest": "~30.0.0",
    "@types/js-yaml": "~4.0.9",
    "@types/jsonwebtoken": "~9.0.10",
    "@types/node": "~20.19.43",
    "@types/pg": "~8.21.0",
    "@types/supertest": "~7.2.1",
    "fast-check": "~4.9.0",
    "jest": "~30.4.2",
    "supertest": "~7.2.2",
    "ts-jest": "~29.4.11",
    "tsx": "~4.23.1",
    "typescript": "~5.9.3"
  }
}
